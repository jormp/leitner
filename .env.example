# Copia este archivo a .env y rellena los valores
POSTGRES_DB=leitner
POSTGRES_USER=leitner
POSTGRES_PASSWORD=cambia-esta-contraseña

# Secreto para firmar los JWT (genera uno largo y aleatorio)
JWT_SECRET=cambia-este-secreto

# URL pública del front (se usa en el enlace del correo de verificación)
APP_URL=http://localhost:8090
WEB_PORT=8090
# Interfaz donde escucha el front. 127.0.0.1 = solo local (recomendado con proxy HTTPS delante)
WEB_BIND=127.0.0.1
# Proxies delante del backend: 1 en local, 2 si hay un nginx/proxy en el host (VPS)
TRUST_PROXY=1
APP_TIMEZONE=Europe/Madrid

# SMTP (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu-usuario@smtp-brevo.com
SMTP_PASS=tu-clave-smtp
SMTP_FROM=No-Reply <no-reply@tudominio.com>
